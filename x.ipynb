### Diffusion internals summary

- **Forward/noise schedule**: `beta_t` increases linearly; `\bar{\alpha}_t=\prod (1-\beta_t)` yields closed-form `q(x_t|x_0)`.
- **Prediction target**: The UNet predicts noise `ε` (epsilon prediction) and is trained with MSE.
- **Conditioning**: Sum of timestep embedding and class embedding; null class id `10` for unconditional path.
- **Sampling**: Reverse chain uses `\hat{x}_0` from `ε_θ` and the closed-form posterior. Classifier-free guidance scales conditional vs unconditional noise predictions.
- **Quality tips**: More steps, EMA weights, cosine schedule, and wider UNet improve results.# Training loop commentary and helpers (non-intrusive)

def diffusion_loss(eps_pred: torch.Tensor, noise: torch.Tensor) -> torch.Tensor:
    """Standard DDPM epsilon-prediction loss: MSE between predicted and true noise.

    Minimizing E_t,ε[ ||ε_θ(x_t, t, y) - ε||^2 ] encourages accurate denoising.
    """
    return F.mse_loss(eps_pred, noise)

# Notes:
# - Each iteration samples a random timestep t ~ Uniform({0..T-1}), then creates x_t
#   by adding noise to x_0 with q_sample. The model predicts ε_θ(x_t, t, y).
# - Classifier-free guidance is enabled by randomly replacing labels with a null id (10)
#   during training. This teaches the network both conditional and unconditional behavior.
# - At sampling, we interpolate between unconditional and conditional predictions via
#   ε = ε_uncond + s (ε_cond - ε_uncond), steering samples toward the target class.
# Annotated diffusion utilities: forward and reverse (redefines earlier functions)
@torch.no_grad()
def q_sample(x0: torch.Tensor, t: torch.LongTensor, noise: Optional[torch.Tensor] = None):
    """Sample q(x_t | x_0) in closed form.

    x_t = sqrt(\bar{\alpha}_t) x_0 + sqrt(1 - \bar{\alpha}_t) ε, with ε ~ N(0, I).
    """
    if noise is None:
        noise = torch.randn_like(x0)
    return extract(sqrt_alphas_cumprod, t, x0.shape) * x0 + extract(sqrt_one_minus_alphas_cumprod, t, x0.shape) * noise

@torch.no_grad()
def p_mean_variance(model: nn.Module, x_t: torch.Tensor, t: torch.LongTensor, y: torch.LongTensor, guidance_scale: float = 0.0):
    """Compute posterior mean and (log) variance for p_θ(x_{t-1} | x_t).

    Uses epsilon prediction to form \hat{x}_0, then closed-form coefficients for
    the mean of q(x_{t-1} | x_t, x_0). Optionally applies classifier-free guidance:
    ε = ε_uncond + s (ε_cond - ε_uncond).
    """
    null_y = torch.full_like(y, 10)
    eps_cond = model(x_t, t, y)
    if guidance_scale > 0:
        eps_uncond = model(x_t, t, null_y)
        eps = eps_uncond + guidance_scale * (eps_cond - eps_uncond)
    else:
        eps = eps_cond
    x0_pred = (x_t - extract(sqrt_one_minus_alphas_cumprod, t, x_t.shape) * eps) / extract(sqrt_alphas_cumprod, t, x_t.shape)
    x0_pred = x0_pred.clamp(-1.0, 1.0)
    mean = extract(posterior_mean_coef1, t, x_t.shape) * x0_pred + extract(posterior_mean_coef2, t, x_t.shape) * x_t
    log_var = extract(posterior_log_variance_clipped, t, x_t.shape)
    return mean, log_var

@torch.no_grad()
def p_sample(model: nn.Module, x_t: torch.Tensor, t: torch.LongTensor, y: torch.LongTensor, guidance_scale: float = 0.0):
    """One reverse diffusion step: sample x_{t-1} given x_t.

    If t == 0, return the mean (deterministic). Otherwise, add Gaussian noise with
    the model-implied variance.
    """
    mean, log_var = p_mean_variance(model, x_t, t, y, guidance_scale)
    if (t == 0).all():
        return mean
    noise = torch.randn_like(x_t)
    return mean + (0.5 * log_var).exp() * noise

@torch.no_grad()
def p_sample_loop(model: nn.Module, shape: Tuple[int, int, int, int], steps: int, labels: torch.LongTensor, guidance_scale: float = 0.0):
    """Run the full reverse process from Gaussian noise to images.

    Args:
        model: Noise predictor ε_θ.
        shape: Output tensor shape (B, C, H, W).
        steps: Number of discretized reverse steps to take (<= T).
        labels: Class labels per sample (0..9).
        guidance_scale: Classifier-free guidance strength s.
    Returns:
        Final samples x_0 (approximately) after iterating t = steps-1 .. 0.
    """
    b = shape[0]
    x = torch.randn(shape, device=DEVICE)
    steps = int(steps)
    timesteps = torch.linspace(T - 1, 0, steps, device=DEVICE).long()
    for t_scalar in timesteps:
        t = torch.full((b,), int(t_scalar.item()), device=DEVICE, dtype=torch.long)
        x = p_sample(model, x, t, labels, guidance_scale)
    return x# Annotated model: small class-conditional UNet for 32x32 (redefines earlier classes)
class SinusoidalPosEmb(nn.Module):
    """Sinusoidal timestep embedding.

    Maps integer timesteps t in [0, T) to a continuous embedding of size `dim`.
    This provides the network with a notion of time in the diffusion chain.
    """
    def __init__(self, dim: int):
        super().__init__()
        self.dim = dim
    def forward(self, t: torch.LongTensor):
        """Return embeddings of shape [B, dim] for integer timesteps t."""
        device = t.device
        half = self.dim // 2
        freqs = torch.exp(-math.log(10000) * torch.arange(0, half, device=device).float() / float(half - 1))
        args = t.float().unsqueeze(1) * freqs.unsqueeze(0)
        emb = torch.cat([torch.sin(args), torch.cos(args)], dim=-1)
        if self.dim % 2 == 1:
            emb = torch.cat([emb, torch.zeros_like(emb[:, :1])], dim=-1)
        return emb

class ResidualBlock(nn.Module):
    """Residual block with FiLM-style conditioning from time/class embeddings."""
    def __init__(self, in_ch: int, out_ch: int, cond_dim: int):
        super().__init__()
        self.norm1 = nn.GroupNorm(8, in_ch)
        self.act = nn.SiLU()
        self.conv1 = nn.Conv2d(in_ch, out_ch, 3, padding=1)
        self.norm2 = nn.GroupNorm(8, out_ch)
        self.conv2 = nn.Conv2d(out_ch, out_ch, 3, padding=1)
        self.cond = nn.Linear(cond_dim, out_ch)
        self.skip = nn.Conv2d(in_ch, out_ch, 1) if in_ch != out_ch else nn.Identity()
    def forward(self, x: torch.Tensor, cond: torch.Tensor):
        """Apply conditioned residual block.

        Args:
            x: Input feature map [B, C, H, W].
            cond: Conditioning vector [B, cond_dim] (time + class).
        """
        h = self.conv1(self.act(self.norm1(x)))
        h = h + self.cond(cond).unsqueeze(-1).unsqueeze(-1)
        h = self.conv2(self.act(self.norm2(h)))
        return h + self.skip(x)

class Down(nn.Module):
    """Downsampling by strided conv (H,W -> H/2, W/2)."""
    def __init__(self, in_ch: int, out_ch: int):
        super().__init__()
        self.op = nn.Conv2d(in_ch, out_ch, 3, stride=2, padding=1)
    def forward(self, x: torch.Tensor):
        return self.op(x)

class Up(nn.Module):
    """Nearest-neighbor upsample followed by a 3x3 conv (H,W -> 2H, 2W)."""
    def __init__(self, in_ch: int, out_ch: int):
        super().__init__()
        self.up = nn.Upsample(scale_factor=2, mode='nearest')
        self.conv = nn.Conv2d(in_ch, out_ch, 3, padding=1)
    def forward(self, x: torch.Tensor):
        return self.conv(self.up(x))

class UNet32(nn.Module):
    """Compact UNet predicting noise ε_θ(x_t, t, y) for 32x32 images.

    Class-conditioning uses an embedding summed with a timestep embedding.
    The model predicts additive Gaussian noise at each timestep (epsilon prediction).
    """
    def __init__(self, in_channels: int = 3, base_channels: int = 64, class_embed_num: int = 11):
        super().__init__()
        ch1, ch2, ch3 = base_channels, base_channels * 2, base_channels * 2
        time_dim = base_channels * 4
        self.time_mlp = nn.Sequential(
            SinusoidalPosEmb(time_dim),
            nn.Linear(time_dim, time_dim),
            nn.SiLU(),
            nn.Linear(time_dim, time_dim),
        )
        self.class_emb = nn.Embedding(class_embed_num, time_dim)  # class ids 0..9, null id 10

        self.in_conv = nn.Conv2d(in_channels, ch1, 3, padding=1)
        self.rb1 = ResidualBlock(ch1, ch1, time_dim)
        self.rb2 = ResidualBlock(ch1, ch1, time_dim)
        self.down1 = Down(ch1, ch2)
        self.rb3 = ResidualBlock(ch2, ch2, time_dim)
        self.down2 = Down(ch2, ch3)

        self.mid1 = ResidualBlock(ch3, ch3, time_dim)
        self.mid2 = ResidualBlock(ch3, ch3, time_dim)

        self.up1 = Up(ch3, ch2)
        self.rb4 = ResidualBlock(ch2 + ch2, ch2, time_dim)  # skip from s2
        self.up2 = Up(ch2, ch1)
        self.rb5 = ResidualBlock(ch1 + ch1, ch1, time_dim)  # skip from s1

        self.out_norm = nn.GroupNorm(8, ch1)
        self.out_conv = nn.Conv2d(ch1, in_channels, 3, padding=1)

    def forward(self, x: torch.Tensor, t: torch.LongTensor, y: torch.LongTensor):
        """Predict per-pixel noise ε given noised input x_t, timestep t, and label y.

        Args:
            x: Noised image x_t [B, 3, 32, 32].
            t: Timesteps [B].
            y: Class labels [B] with 0..9, or 10 for null (unconditional).
        Returns:
            Predicted noise ε_θ of same shape as x.
        """
        temb = self.time_mlp(t)
        cemb = self.class_emb(y)
        cond = temb + cemb

        x0 = self.in_conv(x)
        s1 = self.rb2(self.rb1(x0, cond), cond)
        d1 = self.down1(s1)
        s2 = self.rb3(d1, cond)
        d2 = self.down2(s2)

        m = self.mid2(self.mid1(d2, cond), cond)

        u1 = self.up1(m)
        u1 = torch.cat([u1, s2], dim=1)
        u1 = self.rb4(u1, cond)
        u2 = self.up2(u1)
        u2 = torch.cat([u2, s1], dim=1)
        u2 = self.rb5(u2, cond)

        out = self.out_conv(F.silu(self.out_norm(u2)))
        return out# Annotated diffusion schedule and precomputations (redefines earlier symbols)
T = 1000  # total diffusion steps

def linear_beta_schedule(timesteps: int, beta_start: float = 1e-4, beta_end: float = 0.02):
    """Create a linear noise schedule beta_t over discrete timesteps.

    beta_t controls how much Gaussian noise is added at each forward step
    q(x_t | x_{t-1}). Starting small and ending larger increases noise over time.
    """
    return torch.linspace(beta_start, beta_end, timesteps, dtype=torch.float32, device=DEVICE)

# Per-step and cumulative noise coefficients
betas = linear_beta_schedule(T)
alphas = 1.0 - betas
alphas_cumprod = torch.cumprod(alphas, dim=0)  # \bar{\alpha}_t
alphas_cumprod_prev = torch.cat([torch.tensor([1.0], device=DEVICE), alphas_cumprod[:-1]], dim=0)

# Closed-form terms for q(x_t | x_0) = N( sqrt(\bar{\alpha}_t) x_0, (1-\bar{\alpha}_t) I )
sqrt_alphas_cumprod = torch.sqrt(alphas_cumprod)
sqrt_one_minus_alphas_cumprod = torch.sqrt(1.0 - alphas_cumprod)

# Posterior q(x_{t-1} | x_t, x_0) terms used during sampling
posterior_variance = betas * (1.0 - alphas_cumprod_prev) / (1.0 - alphas_cumprod)
posterior_log_variance_clipped = torch.log(torch.clamp(posterior_variance, min=1e-20))
posterior_mean_coef1 = betas * torch.sqrt(alphas_cumprod_prev) / (1.0 - alphas_cumprod)
posterior_mean_coef2 = (1.0 - alphas_cumprod_prev) * torch.sqrt(alphas) / (1.0 - alphas_cumprod)

def extract(a: torch.Tensor, t: torch.LongTensor, shape):
    """Gather per-batch t-indexed coefficients and reshape for broadcasting.

    Args:
        a: 1D tensor of length T with coefficients (e.g., \bar{\alpha}_t).
        t: Long tensor [B] of timesteps per batch item.
        shape: Target broadcast shape, typically [B, C, H, W].
    Returns:
        Tensor broadcastable to `shape` for elementwise operations.
    """
    out = a.gather(-1, t)
    while len(out.shape) < len(shape):
        out = out.unsqueeze(-1)
    return out{
